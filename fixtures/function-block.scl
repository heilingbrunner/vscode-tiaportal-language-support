FUNCTION_BLOCK "Demo_FB"
TITLE = Demo function block
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : tester
FAMILY : demo
VERSION : 0.1
// KNOW_HOW_PROTECT
   VAR_INPUT
      It_Cycle { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Time;   // previous cycle
      Ist_Valve : "DataTyp_Valve";
      Ib_Start : Bool;
   END_VAR

   VAR_IN_OUT
      IQr_Cache : LReal;   // cache
      IQst_Valve : "DataTyp_Valve";
   END_VAR

   VAR_INPUT DB_SPECIFIC
      Ip_Db : DB_ANY;
   END_VAR

   VAR
      Ins_Delay {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
   END_VAR

   VAR RETAIN
      Counter : DInt := 5;
   END_VAR

   VAR_TEMP
      tr_energy : LReal;   // temp value
   END_VAR

   VAR CONSTANT
      cr_Limit : Real := 100.0;
   END_VAR


BEGIN
	REGION Calc
	    // comment with IF and REGION keywords
	    IF #Ib_Start THEN
	        #tr_energy := 1.0;   (* block *)
	        FOR #i := 0 TO 3 DO
	            #IQr_Cache := #IQr_Cache + 1.0;
	        END_FOR;
	    END_IF;
	END_REGION

	REGION Outer
	    REGION Inner
	        CASE #state OF
	            0: #x := 1;
	        END_CASE;
	    END_REGION
	END_REGION
(* multi
   line comment *)
	#text := 'IF not a keyword';
END_FUNCTION_BLOCK
