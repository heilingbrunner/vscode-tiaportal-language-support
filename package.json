{
    "name": "vscode-tiaportal-language-support",
    "author": {
        "name": "j.heilingbrunner",
        "email": "j.heilingbrunner@gmail.com"
    },
    "publisher": "JHeilingbrunner",
    "repository": {
        "type": "git",
        "url": "https://github.com/heilingbrunner/vscode-tiaportal-language-support.git"
    },
    "displayName": "TIA Portal Language Support",
    "description": "Syntax highlighting for Siemens TIA Portal",
    "icon": "assets/vscode-tiaportal-syntaxes-logo.png",
    "version": "0.0.5",
    "engines": {
        "vscode": "^1.140.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "vscode",
        "tia",
        "tia-portal",
        "syntax highlighting",
        "siemens",
        "awl",
        "stl",
        "db",
        "udt",
        "scl"
    ],
    "main": "./dist/extension.js",
    "scripts": {
        "tokenize": "node scripts/tokenize.js",
        "build": "node esbuild.mjs",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "vscode:prepublish": "node esbuild.mjs --production"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/vscode": "^1.140.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.2",
        "fast-xml-parser": "^5.11.2",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5",
        "vscode-oniguruma": "2.0.1",
        "vscode-textmate": "9.2.0"
    },
    "contributes": {
        "customEditors": [
            {
                "viewType": "tia.viewer",
                "displayName": "TIA Viewer",
                "selector": [
                    {
                        "filenamePattern": "*.xml"
                    },
                    {
                        "filenamePattern": "*.db"
                    },
                    {
                        "filenamePattern": "*.udt"
                    },
                    {
                        "filenamePattern": "*.scl"
                    },
                    {
                        "filenamePattern": "*.awl"
                    },
                    {
                        "filenamePattern": "*.stl"
                    }
                ],
                "priority": "option"
            }
        ],
        "commands": [
            {
                "command": "tia.openViewer",
                "title": "TIA: Open Viewer to the Side"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "tia.openViewer",
                    "when": "resourceExtname == .xml || resourceExtname == .db || resourceExtname == .udt || resourceExtname == .scl || resourceExtname == .awl || resourceExtname == .stl",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "command": "tia.openViewer",
                    "when": "resourceExtname == .xml || resourceExtname == .db || resourceExtname == .udt || resourceExtname == .scl || resourceExtname == .awl || resourceExtname == .stl",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "TIA Viewer",
            "properties": {
                "tiaViewer.culture": {
                    "type": "string",
                    "default": "",
                    "description": "Culture used for titles and comments in the viewer (for example de-DE). Empty = first available text."
                }
            }
        },
        "languages": [
            {
                "id": "scl",
                "aliases": [
                    "TIA Portal: Structured Control Language",
                    "scl"
                ],
                "extensions": [
                    ".scl"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "awl",
                "aliases": [
                    "TIA Portal: Statement List",
                    "awl",
                    "stl"
                ],
                "extensions": [
                    ".awl",
                    ".stl"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "db",
                "aliases": [
                    "TIA Portal: Data Block",
                    "db"
                ],
                "extensions": [
                    ".db"
                ]
            },
            {
                "id": "udt",
                "aliases": [
                    "TIA Portal: User-Defined Type",
                    "udt"
                ],
                "extensions": [
                    ".udt"
                ]
            }
        ],
        "grammars": [
            {
                "language": "scl",
                "scopeName": "source.tia.scl",
                "path": "./syntaxes/scl.tmLanguage.json"
            },
            {
                "language": "awl",
                "scopeName": "source.tia.awl",
                "path": "./syntaxes/awl.tmLanguage.json"
            },
            {
                "language": "db",
                "scopeName": "source.tia.db",
                "path": "./syntaxes/db.tmLanguage.json"
            },
            {
                "language": "udt",
                "scopeName": "source.tia.udt",
                "path": "./syntaxes/udt.tmLanguage.json"
            }
        ]
    }
}
